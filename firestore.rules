rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberOf(storeId) {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)
        );
    }

    function ownerOf(storeId) {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)
        ) &&
        get(
          /databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)
        ).data.role == 'owner';
    }

    function hasRole(storeId, roleId) {
      return memberOf(storeId) &&
        get(
          /databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)
        ).data.role == roleId;
    }

    function hasPermission(storeId, permission) {
      return memberOf(storeId) &&
        exists(
          /databases/$(database)/documents/stores/$(storeId)/users/$(request.auth.uid)
        ) &&
        get(
          /databases/$(database)/documents/stores/$(storeId)/users/$(request.auth.uid)
        ).data.status == 'active' &&
        (
          get(
            /databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)
          ).data.role == 'owner' ||
          (
            get(
              /databases/$(database)/documents/stores/$(storeId)/users/$(request.auth.uid)
            ).data.permissionOverrides.get(permission, null) == true ||
            (
              get(
                /databases/$(database)/documents/stores/$(storeId)/users/$(request.auth.uid)
              ).data.permissionOverrides.get(permission, null) == null &&
              get(
                /databases/$(database)/documents/stores/$(storeId)/roles/$(get(
                  /databases/$(database)/documents/stores/$(storeId)/users/$(request.auth.uid)
                ).data.roleId)
              ).data.permissions.hasAny([permission])
            )
          )
        );
    }

    function ownerAfter(storeId) {
      return signedIn() &&
        getAfter(
          /databases/$(database)/documents/stores/$(storeId)
        ).data.ownerUid == request.auth.uid;
    }

    // A join is only valid when the invitation exists, points to the same
    // store and that store document still exists.
    function validStoreInvitation(storeId, inviteCode) {
      return signedIn() &&
        inviteCode is string &&
        exists(
          /databases/$(database)/documents/stores/$(storeId)
        ) &&
        exists(
          /databases/$(database)/documents/store_invites/$(inviteCode)
        ) &&
        get(
          /databases/$(database)/documents/store_invites/$(inviteCode)
        ).data.storeId == storeId;
    }

    function validApplicationCollection(collection) {
      return collection in [
        'products',
        'sales',
        'purchases',
        'clients',
        'distributors',
        'debts',
        'debt_movements',
        'inventory_movements',
        'settings',
        'client_groups',
        'provider_routes',
        'provider_catalog',
        'electronic_balance_accounts',
        'electronic_balance_transactions'
      ];
    }

    function canReadCollection(storeId, collection) {
      return collection == 'products' ? hasPermission(storeId, 'products.view') :
        collection == 'sales' ? hasPermission(storeId, 'sales.view') :
        collection == 'purchases' ? hasPermission(storeId, 'purchases.view') :
        collection == 'clients' ? hasPermission(storeId, 'clients.view') :
        collection == 'distributors' ? hasPermission(storeId, 'providers.view') :
        collection == 'debts' ? hasPermission(storeId, 'debts.view') :
        collection == 'debt_movements' ? hasPermission(storeId, 'debts.view') :
        collection == 'inventory_movements' ? hasPermission(storeId, 'inventory.view') :
        collection == 'settings' ? hasPermission(storeId, 'settings.view') :
        collection == 'client_groups' ? hasPermission(storeId, 'clients.view') :
        collection == 'provider_routes' ? hasPermission(storeId, 'providers.view') :
        collection == 'provider_catalog' ? hasPermission(storeId, 'providers.view') :
        collection == 'electronic_balance_accounts' ? hasPermission(storeId, 'sales.view') :
        collection == 'electronic_balance_transactions' ? hasPermission(storeId, 'sales.view') :
        false;
    }

    function canWriteCollection(storeId, collection, action) {
      return collection == 'products' ? (
          action == 'create' ? hasPermission(storeId, 'inventory.create') :
          action == 'update' ? hasPermission(storeId, 'inventory.edit') :
          hasPermission(storeId, 'inventory.delete')
        ) :
        collection == 'sales' ? (
          action == 'create' ? hasPermission(storeId, 'sales.create') :
          action == 'update' ? hasPermission(storeId, 'sales.edit') :
          hasPermission(storeId, 'sales.delete')
        ) :
        collection == 'purchases' ? (
          action == 'create' ? hasPermission(storeId, 'purchases.create') :
          action == 'update' ? hasPermission(storeId, 'purchases.edit') :
          hasPermission(storeId, 'purchases.delete')
        ) :
        collection == 'clients' ? (
          action == 'create' ? hasPermission(storeId, 'clients.create') :
          action == 'update' ? hasPermission(storeId, 'clients.edit') :
          hasPermission(storeId, 'clients.delete')
        ) :
        collection == 'distributors' ? (
          action == 'create' ? hasPermission(storeId, 'providers.create') :
          action == 'update' ? hasPermission(storeId, 'providers.edit') :
          hasPermission(storeId, 'providers.delete')
        ) :
        collection == 'debts' ? (
          action == 'create' ? hasPermission(storeId, 'debts.create') :
          action == 'update' ? hasPermission(storeId, 'debts.edit') :
          hasPermission(storeId, 'debts.delete')
        ) :
        collection == 'debt_movements' ? (
          action == 'create' ? hasPermission(storeId, 'debts.create') :
          action == 'update' ? hasPermission(storeId, 'debts.edit') :
          hasPermission(storeId, 'debts.delete')
        ) :
        collection == 'inventory_movements' ? (
          action == 'create' ? hasPermission(storeId, 'inventory.create') :
          action == 'update' ? hasPermission(storeId, 'inventory.edit') :
          hasPermission(storeId, 'inventory.delete')
        ) :
        collection == 'settings' ? hasPermission(storeId, 'settings.edit') :
        collection == 'client_groups' ? (
          action == 'create' ? hasPermission(storeId, 'clients.create') :
          action == 'update' ? hasPermission(storeId, 'clients.edit') :
          hasPermission(storeId, 'clients.delete')
        ) :
        collection == 'provider_routes' ? (
          action == 'create' ? hasPermission(storeId, 'providers.create') :
          action == 'update' ? hasPermission(storeId, 'providers.edit') :
          hasPermission(storeId, 'providers.delete')
        ) :
        collection == 'provider_catalog' ? (
          action == 'create' ? hasPermission(storeId, 'providers.create') :
          action == 'update' ? hasPermission(storeId, 'providers.edit') :
          hasPermission(storeId, 'providers.delete')
        ) :
        collection == 'electronic_balance_accounts' ? (
          action == 'create' ? hasPermission(storeId, 'sales.create') :
          action == 'update' ? hasPermission(storeId, 'sales.edit') :
          hasPermission(storeId, 'sales.delete')
        ) :
        collection == 'electronic_balance_transactions' ? (
          action == 'create' ? hasPermission(storeId, 'sales.create') :
          action == 'update' ? hasPermission(storeId, 'sales.edit') :
          hasPermission(storeId, 'sales.delete')
        ) :
        false;
    }

    match /_stellar_pos_diagnostics/connection {
      allow read: if signedIn();
      allow write: if false;
    }

    match /stores/{storeId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.inviteCode is string;

      allow get: if memberOf(storeId);

      allow update: if ownerOf(storeId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.name is string
        && request.resource.data.inviteCode is string
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'inviteCode', 'updatedAt']);

      allow delete: if false;
    }

    match /stores/{storeId}/members/{uid} {
      allow get: if signedIn() &&
        (request.auth.uid == uid || ownerOf(storeId));

      allow list: if ownerOf(storeId);

      allow create: if signedIn() &&
        (
          (
            uid == request.auth.uid &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.storeId == storeId &&
            request.resource.data.role == 'owner' &&
            ownerAfter(storeId)
          )
          ||
          (
            uid == request.auth.uid &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.storeId == storeId &&
            request.resource.data.role == 'member' &&
            validStoreInvitation(
              storeId,
              request.resource.data.inviteCode
            )
          )
        );

      allow update: if ownerOf(storeId) && uid != request.auth.uid;
      allow delete: if ownerOf(storeId) && uid != request.auth.uid;
    }

    match /stores/{storeId}/users/{userId} {
      allow get: if signedIn() &&
        (
          userId == request.auth.uid ||
          hasPermission(storeId, 'users.view')
        );

      allow list: if hasPermission(storeId, 'users.view');

      allow create: if signedIn() &&
        (
          (
            request.auth.uid == userId &&
            request.resource.data.authUid == request.auth.uid &&
            request.resource.data.storeId == storeId &&
            request.resource.data.roleId == 'owner' &&
            ownerOf(storeId)
          )
          ||
          (
            request.auth.uid == request.resource.data.authUid &&
            request.resource.data.storeId == storeId &&
            request.resource.data.roleId == 'employee' &&
            memberOf(storeId)
          )
        );

      allow update: if (
          ownerOf(storeId) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.authUid == resource.data.authUid &&
          request.resource.data.storeId == resource.data.storeId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'displayName',
              'roleId',
              'status',
              'email',
              'lastSeenAt',
              'permissionOverrides'
            ])
        ) ||
        (
          hasPermission(storeId, 'users.manage') &&
          resource.data.roleId != 'owner' &&
          request.resource.data.roleId != 'owner' &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.authUid == resource.data.authUid &&
          request.resource.data.storeId == resource.data.storeId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'displayName',
              'roleId',
              'status',
              'email',
              'lastSeenAt',
              'permissionOverrides'
            ])
        ) ||
        (
          userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'lastSeenAt'])
        );

      allow delete: if (ownerOf(storeId) || hasPermission(storeId, 'users.manage')) && userId != request.auth.uid && resource.data.roleId != 'owner';
    }

    match /stores/{storeId}/roles/{roleId} {
      allow get, list: if hasPermission(storeId, 'users.view');
      allow create, update, delete: if hasPermission(storeId, 'users.manage');
    }

    match /stores/{storeId}/devices/{deviceId} {
      allow get: if signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          hasPermission(storeId, 'devices.view')
        );

      allow list: if hasPermission(storeId, 'devices.view');

      allow create: if signedIn() &&
        memberOf(storeId) &&
        get(
          /databases/$(database)/documents/stores/$(storeId)/users/$(request.resource.data.userId)
        ).data.authUid == request.auth.uid;

      allow update: if hasPermission(storeId, 'devices.manage') ||
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastSeenAt', 'appVersion', 'osVersion', 'model', 'manufacturer', 'platform'])
        );

      allow delete: if hasPermission(storeId, 'devices.manage');
    }

    match /store_invites/{inviteCode} {
      allow get: if signedIn();

      allow create: if signedIn()
        && request.resource.data.storeId is string
        && request.resource.data.createdBy == request.auth.uid
        && (
          ownerOf(request.resource.data.storeId)
          || ownerAfter(request.resource.data.storeId)
        );

      allow update: if false;

      allow delete: if ownerOf(resource.data.storeId);
    }

    function documentBelongsToStore(storeId, data) {
      return data.storeId == storeId &&
        (
          data.metadata == null ||
          data.metadata.storeId == storeId
        );
    }

    match /stores/{storeId}/{collection}/{documentId} {
      allow read: if validApplicationCollection(collection)
        && canReadCollection(storeId, collection);

      allow create: if validApplicationCollection(collection)
        && canWriteCollection(storeId, collection, 'create')
        && documentBelongsToStore(storeId, request.resource.data);

      allow update: if validApplicationCollection(collection)
        && canWriteCollection(storeId, collection, 'update')
        && documentBelongsToStore(storeId, request.resource.data);

      allow delete: if validApplicationCollection(collection)
        && canWriteCollection(storeId, collection, 'delete');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
