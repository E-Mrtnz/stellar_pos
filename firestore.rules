rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberOf(storeId) {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)
        );
    }

    function ownerOf(storeId) {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)
        ) &&
        get(
          /databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)
        ).data.role == 'owner';
    }

    function ownerAfter(storeId) {
      return signedIn() &&
        getAfter(
          /databases/$(database)/documents/stores/$(storeId)
        ).data.ownerUid == request.auth.uid;
    }

    function validApplicationCollection(collection) {
      return collection in [
        'products',
        'sales',
        'purchases',
        'clients',
        'distributors',
        'debts',
        'debt_movements',
        'inventory_movements',
        'settings',
        'client_groups',
        'provider_routes',
        'provider_catalog',
        'electronic_balance_accounts',
        'electronic_balance_transactions'
      ];
    }

    // Temporary connectivity/authentication diagnostic.
    match /_stellar_pos_diagnostics/connection {
      allow read: if signedIn();
      allow write: if false;
    }

    // Store metadata. The store document id is the immutable internal
    // identity; name and invitation code are editable by the owner.
    match /stores/{storeId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.inviteCode is string;

      allow get: if memberOf(storeId);

      allow update: if ownerOf(storeId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.name is string
        && request.resource.data.inviteCode is string
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'inviteCode', 'updatedAt']);

      allow delete: if false;
    }

    // Store membership. A new owner membership must be created atomically
    // with its store document. A regular member can only join through a
    // valid invitation code that resolves to this exact store id.
    match /stores/{storeId}/members/{uid} {
      allow get: if signedIn()
        && (request.auth.uid == uid || ownerOf(storeId));

      allow list: if ownerOf(storeId);

      allow create: if signedIn()
        && (
          (
            uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.storeId == storeId
            && request.resource.data.role == 'owner'
            && ownerAfter(storeId)
          )
          ||
          (
            uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.storeId == storeId
            && request.resource.data.role == 'member'
            && request.resource.data.inviteCode is string
            && exists(
              /databases/$(database)/documents/store_invites/$(request.resource.data.inviteCode)
            )
            && get(
              /databases/$(database)/documents/store_invites/$(request.resource.data.inviteCode)
            ).data.storeId == storeId
          )
        );

      allow update: if ownerOf(storeId) && uid != request.auth.uid;
      allow delete: if ownerOf(storeId) && uid != request.auth.uid;
    }

    // Invitation codes are intentionally lookup documents. Knowing a code
    // is the secret required to discover and join its associated store.
    match /store_invites/{inviteCode} {
      allow get: if signedIn();

      allow create: if signedIn()
        && request.resource.data.storeId is string
        && request.resource.data.createdBy == request.auth.uid
        && (
          ownerOf(request.resource.data.storeId)
          || ownerAfter(request.resource.data.storeId)
        );

      allow update: if false;

      allow delete: if ownerOf(resource.data.storeId);
    }

    // All application data is partitioned by store and requires an explicit
    // membership document for the authenticated user.
    match /stores/{storeId}/{collection}/{documentId} {
      allow read, write: if validApplicationCollection(collection)
        && memberOf(storeId);
    }

    // Everything else remains locked by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
